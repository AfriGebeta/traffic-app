{
  "expo": {
    "name": "Gebeta Maps",
    "slug": "gebeta-maps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "trafficapp",
    "userInterfaceStyle": "automatic",
    "associatedDomains": [
      "applinks:maps.gebeta.app"
    ],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.trafficapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.trafficapp",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "splash": {
        "image": "./assets/images/gebetamaps.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "maps.gebeta.app"
            },
            {
              "scheme": "trafficapp"
            },
            {
              "scheme": "trafficapp",
              "host": "telegram-auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/gebetamaps.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d0a676b9-12b7-468e-9057-83e7f9cbcc51"
      }
    },
    "owner": "gebeta-maps"
  }
}